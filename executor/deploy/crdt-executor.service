[Unit]
Description=CRDT Executor (Docker Compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust to wherever you clone the repo on the VM.
WorkingDirectory=/opt/crdt/executor/deploy
EnvironmentFile=/opt/crdt/executor/deploy/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
