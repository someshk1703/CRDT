# Executor (code execution microservice) environment variables
# Copy this to executor/.env and fill in your values — never commit .env

PORT=3002

# ─── Auth (required once this service is reachable from the public internet) ─
# Shared bearer token — Vercel's /api/execute sends this as `Authorization:
# Bearer <token>`. Leave unset for local dev only (logs a warning, allows
# unauthenticated requests).
EXECUTOR_AUTH_TOKEN=

# ─── Gemini API (fallback execution when Docker isn't reachable, e.g. no
#     daemon/socket available, such as on Railway) ────────────────────────────
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional model override.
GEMINI_MODEL=gemini-2.5-flash
