# Executor (code execution microservice) environment variables
# Copy this to executor/.env and fill in your values — never commit .env

PORT=3002

# ─── Judge0 CE (hosted sandboxed execution API) ──────────────────────────────
# Sign up for a free RapidAPI key: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your-rapidapi-key

# Only override these if you're using a different Judge0 host (e.g. self-hosted).
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
