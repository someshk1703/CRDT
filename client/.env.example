# Client environment variables
# Copy this to .env.local — never commit .env.local

# ─── Supabase (required) ──────────────────────────────────────────────────────

# Supabase project URL
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Supabase anon/public key — safe to expose in client code (NOT the service role key)
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── API base URL (optional) ──────────────────────────────────────────────────

# CRDT sync now rides Supabase Realtime broadcast (no WebSocket server needed).
# /api/* routes (rooms, catchup, snapshot, execute) are Vercel serverless
# functions deployed alongside this client in the same project — leave unset
# for same-origin requests. Only set this if the API is deployed separately.
# VITE_API_URL=https://my-crdt.vercel.app

# ─── Server-only env vars (set in the Vercel project dashboard, NOT here) ─────
# These back client/api/* and must never be prefixed with VITE_ (which would
# bundle them into client JS):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  — bypasses RLS, server-side only
#   JUDGE0_API_KEY, JUDGE0_API_HOST, JUDGE0_API_URL — RapidAPI Judge0 CE creds
#   ALLOWED_ORIGIN — exact production origin (scheme+host only, no path/hash),
#     e.g. https://enginex-app.vercel.app — locks down Access-Control-Allow-Origin.
#     Leave unset in local dev to reflect the request Origin instead.

