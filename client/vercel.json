{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "functions": {
    "api/execute.ts": {
      "maxDuration": 20
    },
    "api/rooms/index.ts": {
      "maxDuration": 10
    },
    "api/rooms/[slug].ts": {
      "maxDuration": 10
    },
    "api/catchup.ts": {
      "maxDuration": 10
    },
    "api/snapshot.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
